# Credenciais — NUNCA versionar
var/www/html/env.php
**/env.php
var/www/html/config.php
# Env fora do webroot (segredos reais) + template já preenchido com valores reais
var/www/syde_env.php
**/syde_env.php
var/www/syde_env.example.php

# WhatsApp / Baileys — credenciais da conta e dependências (NUNCA commitar!)
# creds.json + chaves = controle total da conta WhatsApp se vazar.
opt/whatsapp-baileys-server/sessions/
opt/whatsapp-baileys-server/node_modules/
opt/whatsapp-baileys-server/logs/
**/node_modules/
**/sessions/
**/creds.json
**/wa_internal_key*
# Snapshot da VPS com sessions/ (credenciais) dentro — nunca commitar.
whatsapp-baileys-server.zip

# Pacote de update (~38 MB por versão). Ele é ASSET da Release do GitHub, não
# arquivo do repositório — o cliente baixa pela URL do manifest, nunca do git.
# Commitá-lo levou o .git a 2,1 GB para um repositório de 4 arquivos.
syde-windows.zip
# Mapa de símbolos do build ofuscado: fica fora do pacote, mas também fora do
# repositório (guarde por versão em local próprio para de-simbolizar crashes).
build/symbols/

