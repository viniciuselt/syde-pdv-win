app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Chaves privadas — NUNCA commitar
*.pem
*.pem.bak
*.key
# Exceção: a chave PÚBLICA do auto-update pode (e deve) ficar no repositório —
# é com ela que se confere a assinatura de um manifest. A regra `*.pem` acima
# continua valendo para todo o resto, inclusive a privada.
!update_public.pem
*private*

# Arquivos de sessão do Claude / continuação
.continue/

# hash temporario da senha do admin (deploy-fix-admin.bat)
admin_hash.tmp

# Dumps de banco — NUNCA no projeto (hashes de senha/PIN + PII) — N-25
# (migration_*.sql sao arquivos de deploy e continuam versionaveis)
var/*.sql
*.sql.gz
*mysqldump*
pdv_db.sql
*dump*.sql
*backup*.sql

# Snapshot completo da VPS (fonte PHP + dump do banco + sessions/creds do
# WhatsApp) — material confidencial, NUNCA versionar.
html-backup/

# Backups manuais de fonte (ex.: classic_layout.dart.bak_atalhos). Ficavam em
# lib/ ocupando 440 KB e apareciam nas buscas do editor como se fossem código.
*.bak
*.bak_*
